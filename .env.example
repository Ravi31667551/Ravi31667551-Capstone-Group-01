# composer.sh loads this file (if present) and maps *_HOST / *_USER onto its SERVERS/USERS.
#
# ── Team map (Group 01) — adjust if your ZeroTier IPs change ─────────────────
# RabbitMQ cluster try-order: 1 Bhavna → 2 Dhaya (AWS) → 3 Ravi  (queue_client uses these for failover)
# MySQL replication topology order: Ravi (primary) → Bhavna → Rishu  (app still uses ONE DB_HOST = writer)
# Backend nodes (Flask :5000): Rishu + Dhaya — same .env on both
# Frontend (PHP :7012): Dhaya + Rishu
#
# Person        Role(s)              Typical ZT IP    composer key / note
# Bhavna        RabbitMQ, MySQL rep  10.67.151.114    MESSAGING_HOST
# Dhaya         Frontend, RMQ node,  10.67.151.148    FRONTEND_HOST (Ubuntu)
#               backend node 2       10.67.151.133    Dhaya AWS RabbitMQ (optional fallback)
# Ravi          MySQL primary, RMQ   10.67.151.166    DATABASE_HOST; RMQ node 3 if enabled
# Rishu         Frontend, backend    10.67.151.212    BACKEND_HOST / second FE

# Dhayasagar Ubuntu (PHP :7012) — dhayasubuntuserver
FRONTEND_HOST=10.67.151.148
FRONTEND_USER=dhayak23
# Dhayasagar AWS VM (RabbitMQ cluster) — optional composer.sh overrides
# RABBITMQ_DHAYA_HOST=10.67.151.133
# RABBITMQ_DHAYA_USER=ubuntu

MESSAGING_HOST=10.67.151.114
MESSAGING_USER=bhavnasahai3

BACKEND_HOST=10.67.151.212
BACKEND_USER=vboxuser
# Second Flask node (same app + .env) — required for HAProxy in install-http-loadbalancer.sh
# BACKEND_HOST_2=10.67.151.148
# HAPROXY_FRONT_PORT=8080
# HAPROXY_STATS_PORT=8404
# Optional: appears in GET /health JSON so you can tell backends apart behind HAProxy
# INSTANCE_NAME=rishu-212

DATABASE_HOST=10.67.151.166
DATABASE_USER=ravi

# ── RabbitMQ (order: Bhavna → Dhaya → Ravi) ──────────────────
# Confirm each IP has :5672 listening before relying on fallbacks.
RABBITMQ_HOST=10.67.151.114
RABBITMQ_HOST_FALLBACK=10.67.151.133
RABBITMQ_HOST_FALLBACK2=10.67.151.166
# Equivalent: RABBITMQ_HOSTS=10.67.151.114,10.67.151.133,10.67.151.166
RABBITMQ_PORT=5672
RABBITMQ_USER=group1
RABBITMQ_PASS=12345
# RABBITMQ_VHOST=/
# Match broker queue type (team uses quorum queues). Use classic only if your broker has classic durable queues.
# RMQ_QUEUE_TYPE=quorum

# ── MySQL (single writer for the app — Ravi primary in your replication order) ─
DB_HOST=10.67.151.166
DB_PORT=3306
DB_USER=it490
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_NAME=capstone_db

# ── Adzuna job search API (https://developer.adzuna.com) — used by backend/job_fetcher.py
# Get keys from the Adzuna developer dashboard; never commit real keys to git.
# No spaces around = (e.g. KEY=value not KEY= value)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
# Optional: keyword filter for periodic fetch (empty = broad US results)
ADZUNA_WHAT=
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_MAX_PAGES=2
# Optional: also pull Remotive if Adzuna returns nothing (dev only)
# REMOTIVE_FALLBACK=0
# JOB_FETCH_INTERVAL_HOURS=6

# ── Optional ─────────────────────────────────────────────────
# SESSION_TTL_HOURS=168
# BACKEND_PORT=5000
