# Copy to cluster.env and fill in. Source before running milestone4/*.sh
#   cp milestone4/cluster.env.example milestone4/cluster.env
#   nano milestone4/cluster.env

# ── ZeroTier network (use these for all cross-machine connections) ─────────
ZT_NET="10.67.151.0/24"

# ── Short hostnames (must match /etc/hosts on every cluster node) ───────────
# After running: sudo bash milestone4/add-cluster-hosts.sh

# ── RabbitMQ cluster (2 nodes: Bhavna seed, Ravi joiner) ──────────────────────
RMQ_NODE1_IP=10.67.151.114
RMQ_NODE1_HOST=rabbit1
RMQ_NODE1_USER=bhavnasahai3

RMQ_NODE2_IP=10.67.151.166
RMQ_NODE2_HOST=rabbit2
RMQ_NODE2_USER=ravi

# Discovered primary node (usually Bhavna). Joining nodes use this.
RMQ_CLUSTER_SEED=rabbit1

# ── MySQL replication (Ravi primary; Rishu + Bhavna replicas) ──────────────
MYSQL_PRIMARY_IP=10.67.151.166
MYSQL_PRIMARY_HOST=mysql1
MYSQL_PRIMARY_USER=ravi

MYSQL_REPLICA_RISHU_IP=10.67.151.212
MYSQL_REPLICA_RISHU_SERVER_ID=2

MYSQL_REPLICA_BHAVNA_IP=10.67.151.114
MYSQL_REPLICA_BHAVNA_SERVER_ID=3

MYSQL_DB_NAME=capstone_db

# Replicator user (created on PRIMARY only; max 32 chars for CHANGE MASTER TO)
MYSQL_REPLICATOR_USER=replicator
MYSQL_REPLICATOR_PASSWORD=ChangeMe_Strong1

# Master coordinates — refresh from PRIMARY after RESET SLAVE (SHOW MASTER STATUS)
MYSQL_MASTER_LOG_FILE=mysql-bin.000001
MYSQL_MASTER_LOG_POS=157

# ── Backend nodes (2) ───────────────────────────────────────────────────────
BACKEND_NODE1_IP=10.67.151.166
BACKEND_NODE2_IP=10.67.151.212

# ── Frontend (production = Apache on 2 nodes) ───────────────────────────────
FRONTEND_NODE1_IP=10.67.151.133
FRONTEND_NODE2_IP=10.67.151.212
