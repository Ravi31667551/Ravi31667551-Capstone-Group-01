# MySQL Group Replication (single-primary) — repo root cluster.env
# Copy to cluster.env in the same directory as common.sh / gr-health.sh and fill values.

# ---------- Topology ----------
AWS_REGION=us-east-1
MYSQL_NODE1_IP=10.0.1.10
MYSQL_NODE1_HOST=mysql-gr-1
MYSQL_NODE1_USER=ubuntu

MYSQL_NODE2_IP=10.0.1.11
MYSQL_NODE2_HOST=mysql-gr-2
MYSQL_NODE2_USER=ubuntu

MYSQL_NODE3_IP=10.0.1.12
MYSQL_NODE3_HOST=mysql-gr-3
MYSQL_NODE3_USER=ubuntu

# ---------- Core MySQL ----------
MYSQL_PORT=3306
MYSQL_X_PORT=33060
MYSQL_ROOT_PASSWORD=ChangeMeRootStrong1
MYSQL_APP_DB=capstone_db
MYSQL_APP_USER=it490
MYSQL_APP_PASSWORD=ChangeMeAppStrong1

# ---------- Group Replication ----------
GR_GROUP_NAME=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
GR_LOCAL_ADDRESS_PORT=33061
GR_SEEDS=10.0.1.10:33061,10.0.1.11:33061,10.0.1.12:33061
GR_IP_ALLOWLIST=10.0.0.0/16
GR_SINGLE_PRIMARY_MODE=ON
GR_BOOTSTRAP_NODE=10.0.1.10
GR_RECOVERY_USER=repl_user
GR_RECOVERY_PASSWORD=ChangeMeReplStrong1

# ---------- Router ----------
# Selected architecture: Router runs on node1 (primary at bootstrap time).
ROUTER_BIND_ADDRESS=0.0.0.0
ROUTER_RW_PORT=6446
ROUTER_RO_PORT=6447
ROUTER_USER=mysqlrouter

# ---------- Backend integration ----------
# Path to backend repo and env on backend host.
BACKEND_REPO_PATH=/home/ubuntu/Capstone-Group-01
BACKEND_ENV_FILE=/home/ubuntu/Capstone-Group-01/.env
BACKEND_SYSTEMD_UNIT=jobtracker-backend.service
